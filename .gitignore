# Build output and dependencies
node_modules/
dist/
src-tauri/target/

# Generated by tauri-build at compile time from tauri.conf.json and
# capabilities/. Reproducible, so it is not worth versioning.
src-tauri/gen/

# A venue's trading data. Never committed — it is the business's records, and
# on a developer machine it is throwaway.
*.db
*.db-wal
*.db-shm

# Spooled slips. Written beside the database, so they are already covered when
# it lives outside the repo — but not when SERVEPOINT_DB points inside one.
slips/

# Vite loads .env files automatically, which makes it easy to drop a key into
# one without thinking. This repo is public; keep them out by default.
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
.vscode/
.idea/
*.swp
